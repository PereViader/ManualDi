<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion> <!--Lang version must be 9 because unity3d does not support anything higher-->
    <AssemblyName>ManualDi.Async</AssemblyName>
    <RootNamespace>ManualDi.Async</RootNamespace>
    <RepositoryUrl>https://github.com/PereViader/ManualDi</RepositoryUrl>
    <Product>ManualDi.Async</Product>
    <PackageProjectUrl>https://github.com/PereViader/ManualDi</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\ManualDi.Async.Generators\bin\$(Configuration)\netstandard2.0\ManualDi.Async.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
